# Replace both occurrences of CHANGE_ME with the same URL-safe password.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=55432
# Used when running scripts directly on the host outside Docker Compose:
DATABASE_URL=postgres://smartenance:CHANGE_ME@127.0.0.1:55432/smartenance

# Server automatic database sync (day 25 of each month at 02:00 UTC+8).
# Fill in your Smartenance Premium API account so the `sync` container can sign in automatically.
FESTO_SYNC_USERNAME=
FESTO_SYNC_PASSWORD=
FESTO_SYNC_POLICY=auto
SYNC_ENABLED=true
SYNC_DAYS_OF_MONTH=25
SYNC_TIME_UTC8=02:00
SYNC_CATCH_UP=true
SYNC_MAX_RETRIES=2
SYNC_RETRY_DELAY_SECONDS=1800
