{
  "name": "smartenance-repair-export",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js dev",
    "build": "vinext build",
    "start": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js start -H 127.0.0.1 -p 3000",
    "start:server": "node --env-file-if-exists=.env node_modules/vinext/dist/cli.js start -H 0.0.0.0 -p 3000",
    "lint": "oxlint",
    "test": "node --test tests/*.test.mjs",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.mjs",
    "test:postgres": "node --env-file-if-exists=.env --test tests/postgres.integration.test.mjs",
    "db:local": "node --env-file-if-exists=.env scripts/local-db.mjs start",
    "db:stop": "node --env-file-if-exists=.env scripts/local-db.mjs stop",
    "db:status": "node --env-file-if-exists=.env scripts/local-db.mjs status"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@festo-ui/react": "^11.1.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "html-to-text": "^10.0.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pg": "^8.23.1",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "embedded-postgres": "18.4.0-beta.17",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
